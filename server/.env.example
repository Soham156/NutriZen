# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Connection (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# JWT Configuration (Simple Table Auth - No Expiration)
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters
# Note: Tokens do not expire for persistent sessions

# Password Reset & Email Verification
PASSWORD_RESET_TOKEN_EXPIRY=1h
EMAIL_VERIFICATION_TOKEN_EXPIRY=24h

# Email Configuration (for sending verification/reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@nutrizen.com
SMTP_FROM_NAME=NutriZen

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=15m
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_EXPIRY=30d
MAX_SESSIONS_PER_USER=5

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# API Keys (optional - add as needed)
OPENAI_API_KEY=your-openai-key-here
NUTRITIONIX_APP_ID=your-nutritionix-app-id
NUTRITIONIX_API_KEY=your-nutritionix-api-key

# Logging
LOG_LEVEL=info
LOG_FILE=logs/server.log

# Security
BCRYPT_ROUNDS=10
ENABLE_HTTPS=false

# File Upload (if needed)
MAX_FILE_SIZE=5mb
UPLOAD_DIR=uploads/avatars
